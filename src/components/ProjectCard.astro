---
import type { CollectionEntry } from "astro:content";
import { outcomeParts } from "../lib/site";

interface Props {
  project: CollectionEntry<"projects">;
  activeTag?: string | null;
}
const { project, activeTag = null } = Astro.props;
const { lead, rest } = outcomeParts(project.data.outcome);
const web = project.data.thumbnailKind === "web";
---

<article class="card" data-project data-tags={project.data.tags.join("|")}>
  <div class={`thumb g-${project.data.gradient}`} role="img" aria-label={`${project.data.title} placeholder thumbnail`}>
    <span class="ph">placeholder</span>
    <div class:list={["dev", { web }]}><span>{project.data.title}</span></div>
    <span class="nm">{project.data.slug}.mdx</span>
  </div>
  <div class="cb">
    <span class:list={["status", { dev: project.data.statusKind === "development" }]}>{project.data.status}</span>
    <h3>{project.data.title}</h3>
    <p class="outcome">{lead ? <b>{lead}</b> : null}{lead ? " " : ""}{rest}</p>
    <div class="tags">
      {project.data.tags.map((tag) => <span class:list={["tag", { hit: activeTag === tag }]}>{tag}</span>)}
    </div>
    <a class="lnk" href={`/projects/${project.data.slug}`}>Case study →</a>
  </div>
</article>
