---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import ProjectCard from "../../components/ProjectCard.astro";
import TagFilter from "../../components/TagFilter";
import { PROJECT_TAGS } from "../../lib/site";
import { earlyWork } from "../../data/early-work";

const projects = (await getCollection("projects")).sort((a, b) => a.data.order - b.data.order);
const tags = PROJECT_TAGS.map((name) => ({
  name,
  count: projects.filter((project) => project.data.tags.includes(name)).length,
}));
---

<Base
  title="Selected work — Anthony Smith"
  description="Selected work by Anthony Smith: CastLog, Nutrilogix, VoiceLift, CallCatch, and Rogue River Labs. React Native, AI apps, and API security."
  path="/projects"
  current="work"
>
  <section class="hero" style="padding-bottom:8px">
    <div class="wrap">
      <p class="kick">~/projects</p>
      <h1 class="h1-52">Selected work</h1>
      <p class="lead" style="margin:14px 0 30px;max-width:640px">Apps and products I designed, built and shipped. Each card's outcome line comes from the project page.</p>
      <TagFilter client:idle tags={tags} total={projects.length} />
      <noscript><p class="rescount">Tag links need JavaScript to hide cards. Every project below stays listed.</p></noscript>
    </div>
  </section>
  <section style="padding-top:24px">
    <div class="wrap">
      <div class="cards two">
        {projects.map((project) => <ProjectCard project={project} />)}
      </div>
      <details class="early">
        <summary>
          <span><span class="mono mint">$ ls ./early-work</span> &nbsp;Early work, 2020–2022 · {earlyWork.length} projects</span>
          <span><span class="when-closed">Show →</span><span class="when-open">Hide</span></span>
        </summary>
        <ul class="early-list">
          {earlyWork.map((item) => (
            <li>
              <span class="year">{item.year}</span>
              {item.href ? <a href={item.href}>{item.name}</a> : <span>{item.name}</span>}
              <span class="cat">{item.type}</span>
            </li>
          ))}
        </ul>
      </details>
    </div>
  </section>
</Base>
