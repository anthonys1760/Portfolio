---
import { getCollection, render } from "astro:content";
import Base from "../../layouts/Base.astro";
import { entryId } from "../../lib/site";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => ({ params: { slug: entryId(post) }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const slug = entryId(post);
---

<Base
  title={`${post.data.title} — Field Notes`}
  description={post.data.description}
  path={`/blog/${slug}`}
  current="writing"
  image={post.data.hero}
  imageAlt={post.data.heroAlt}
  imageWidth={post.data.heroWidth}
  imageHeight={post.data.heroHeight}
>
  <section class="hero" style="padding-bottom:48px">
    <div class="wrap prose">
      <p class="crumb"><a href="/blog">~/field notes</a> <span class="p">/</span> {post.data.category}</p>
      <p class="kick">{post.data.date}{post.data.readTime ? ` · ${post.data.readTime}` : ""}</p>
      <h1 class="h1-52">{post.data.title}</h1>
      <p class="lead" style="margin-top:14px">{post.data.description}</p>
      {post.data.hero ? (
        <img class="post-hero" src={post.data.hero} alt={post.data.heroAlt || ""} width={post.data.heroWidth} height={post.data.heroHeight} />
      ) : null}
      <Content />
      {(post.data.seriesPrevSlug || post.data.seriesNextSlug) ? (
        <nav class="series" aria-label="Series">
          {post.data.seriesPrevSlug ? <a href={`/blog/${post.data.seriesPrevSlug}`}>← {post.data.seriesPrevTitle}</a> : <span></span>}
          {post.data.seriesNextSlug ? <a href={`/blog/${post.data.seriesNextSlug}`}>{post.data.seriesNextTitle} →</a> : null}
        </nav>
      ) : null}
    </div>
  </section>
</Base>
