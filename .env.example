# Server-only. Set these in Vercel for Production and Preview.
# Do not commit real values. Stub is the default until the Resend keys exist.

# resend | stub. Leave as stub until the three Resend values below are set.
CONTACT_DELIVERY=stub

# Resend. The from address is on a verified subdomain, for example
# contact@mail.anthonysdigital.net. No auto-reply is sent.
RESEND_API_KEY=
CONTACT_FROM_EMAIL=
CONTACT_TO_EMAIL=

# Upstash Redis REST. Required in production for the rate limit and the
# single-use challenge nonce. There is no in-memory fallback in production.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# HMAC secret for the challenge token and the render timestamp. 32+ bytes.
CONTACT_SECRET=

# Salt for the SHA-256 of the visitor IP. The raw IP is not stored.
IP_HASH_SALT=
